Screen {
    layout: vertical;
    min-width: 100;
    min-height: 24;
}

PipelineStrip {
    height: 3;
    border: solid $accent;
}

#failure-banner {
    height: 1;
    color: red;
    display: none;
}

Horizontal {
    height: 1fr;
}

ExperimentPanel {
    width: 2fr;
    border: solid $primary;
}

BestConfigPanel, BudgetPanel, ReflectionPanel, HistoryTable {
    width: 1fr;
    border: solid $secondary;
}

LogPanel {
    height: 8;
    border: solid $secondary;
}

#run-id {
    height: 1;
}
