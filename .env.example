# Copy this file to .env and fill in real values. .env is gitignored --
# never commit real keys.

# Required. Used for LLM calls (scientist, generator, RAGAS judge, etc.)
# whenever settings.run.llm_provider="openrouter" (the default) or for any
# component (e.g. rerankers, RAGAS judge) whose model_routing.yaml/model
# catalog entry routes through OpenRouter regardless of llm_provider.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional. Only required when settings.run.llm_provider="openai" in
# config/run_settings.yaml, or when a config routes embeddings/generation
# directly through OpenAI. Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Optional. Enables LLM call tracing via Langfuse (https://langfuse.com).
# scripts/run_overnight.py works fine without these -- the integration is
# wrapped in a try/except ImportError and silently no-ops if unset/uninstalled.
# LANGFUSE_PUBLIC_KEY=pk-lf-your-key-here
# LANGFUSE_SECRET_KEY=sk-lf-your-key-here
# LANGFUSE_HOST=https://cloud.langfuse.com
